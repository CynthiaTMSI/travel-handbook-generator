{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/travel-handbook/trip.schema.json",
  "title": "Travel Handbook trip.yaml",
  "type": "object",
  "required": ["trip", "review", "days"],
  "properties": {
    "trip": {
      "type": "object",
      "required": ["title", "start_date", "end_date", "timezone"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "start_date": { "type": "string", "format": "date" },
        "end_date": { "type": "string", "format": "date" },
        "timezone": { "type": "string", "minLength": 1 }
      }
    },
    "review": {
      "type": "object",
      "required": ["status", "unresolved"],
      "properties": {
        "status": { "enum": ["pending", "approved"] },
        "unresolved": { "type": "array", "items": { "type": "string" } }
      }
    },
    "days": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["date", "title", "events"],
        "properties": {
          "date": { "type": "string", "format": "date" },
          "title": { "type": "string", "minLength": 1 },
          "events": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["time", "title"],
              "properties": {
                "time": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$" },
                "title": { "type": "string", "minLength": 1 },
                "duration_minutes": { "type": "integer", "minimum": 0 },
                "map_url": { "type": "string", "format": "uri" }
              }
            }
          }
        }
      }
    }
  }
}
