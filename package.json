{
  "name": "travel-handbook-generator",
  "version": "1.0.0",
  "private": true,
  "description": "A privacy-first, data-driven travel handbook template for Cloudflare Workers.",
  "type": "module",
  "scripts": {
    "validate": "node scripts/validate-trip.mjs && node scripts/privacy-check.mjs",
    "build": "npm run validate && node scripts/build.mjs",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "wrangler": "^4.34.0"
  },
  "engines": {
    "node": ">=20"
  }
}
